{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.houstontxhvacrepair.com" }],
      "destination": "https://houstontxhvacrepair.com/",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.houstontxhvacrepair.com" }],
      "destination": "https://houstontxhvacrepair.com/:path",
      "permanent": true
    }
  ]
}
